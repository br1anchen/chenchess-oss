{
  "name": "@chenchess/ui",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#hooks/*": "./src/hooks/*.ts",
    "#lib/*": "./src/lib/*.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./astryx": "./src/astryx.ts",
    "./assets": "./src/assets.ts",
    "./board": "./src/board/index.ts",
    "./board/fen": "./src/board/fen.ts",
    "./board/presentational": "./src/board/PresentationalChessboard.tsx",
    "./components/*": "./src/components/*.tsx",
    "./contracts": "./src/contracts.ts",
    "./fixtures": "./src/fixtures.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./illustrations": "./src/illustrations.ts",
    "./lib/*": "./src/lib/*.ts",
    "./motion/ink-transition": "./src/motion/inkTransition.ts",
    "./retention": "./src/retention.ts",
    "./review/navigation": "./src/review/ReviewContextNavigation.tsx",
    "./review/navigation-presentation": "./src/review/reviewNavigationPresentation.ts",
    "./review/learning-path-feedback": "./src/review/useAcknowledgedLearningPathFeedback.ts",
    "./review/learning-paths": "./src/review/LearningPathCards.tsx",
    "./review/learning-path-projection": "./src/review/learningPathProjection.ts",
    "./stylex.vite": "./stylex.vite.mjs",
    "./vitest/astryx": "./src/vitest.astryx.ts",
    "./vitest/stylex-shim": "./src/vitest.stylexShim.ts",
    "./illustrations/mountain-mist.webp": "./src/assets/brand/illustrations/mountain-mist.webp",
    "./theme": "./src/theme/ChenTheme.tsx",
    "./theme/breakpoints": "./src/theme/breakpoints.ts",
    "./theme/tokens.stylex": "./src/theme/tokens.stylex.ts",
    "./theme.css": "./src/theme/theme.css",
    "./surfaces.css": "./src/theme/surfaces.css",
    "./theme/built": "./src/theme/generated/ink-wash.js",
    "./workspace/review": "./src/workspace/BrandedReviewWorkspace.tsx",
    "./styles.css": "./src/styles/globals.css"
  },
  "scripts": {
    "check": "bun run theme:check && bun run verify:watercolor-shapes && bun run verify:oauth-consent-css && tsc --project tsconfig.json && tsc --project tsconfig.harness.json",
    "typecheck": "tsc --project tsconfig.json && tsc --project tsconfig.harness.json",
    "lint": "oxlint .",
    "format": "oxfmt --check .",
    "test": "vitest run --minWorkers=1 --maxWorkers=50%",
    "theme:build": "astryx theme build src/theme/inkWash.ts -o src/theme/generated/inkWash.css",
    "theme:check": "astryx theme build src/theme/inkWash.ts -o src/theme/generated/inkWash.css --check",
    "vectorize:chess-pieces": "bun scripts/vectorize-chess-pieces.ts",
    "generate:piece-sprite": "bun scripts/generate-piece-sprite.ts",
    "verify:piece-sprite": "bun scripts/generate-piece-sprite.ts --check",
    "generate:watercolor-shapes": "bun scripts/generate-watercolor-shapes.ts",
    "verify:watercolor-shapes": "bun scripts/generate-watercolor-shapes.ts --check",
    "compose:knight-mark": "bun scripts/compose-knight-mark.ts",
    "astryx": "astryx"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.4.2",
    "@astryxdesign/theme-stone": "^0.4.2",
    "@chenchess/coach-engine-sdk": "workspace:*",
    "@stylexjs/stylex": "^0.19.0",
    "motion": "12.42.2"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.4.2",
    "@storybook/react-vite": "10.5.7",
    "@stylexjs/babel-plugin": "^0.19.0",
    "@stylexjs/unplugin": "^0.19.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^29.1.1",
    "svgo": "4.0.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
