rules_version = '2';

// Browser clients receive no Firestore access. Service accounts use IAM, not
// these rules. Evaluation tooling is granted only the identity-free
// `coach-quality` database and must never receive product-database IAM: the
// Player-to-capture association lives only on `qualityOutbox` and
// `heldQualityCaptures` under `users/{sha256}`. `coach-quality/captures`
// stores no Player association.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/qualityOutbox/{captureId} {
      allow read, write: if false;
    }
    match /users/{userId}/heldQualityCaptures/{captureId} {
      allow read, write: if false;
    }
    match /captures/{captureId} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
