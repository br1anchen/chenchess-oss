{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "jsx-a11y", "react", "typescript", "unicorn", "vitest"],
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "./tooling/oxlint/plugin.js"
    }
  ],
  "ignorePatterns": [
    ".agent/**",
    ".layout-verify/**",
    "tooling/oxlint/**",
    "packages/ui/src/theme/generated/**"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "complexity": ["error", { "max": 20 }],
    "import/no-unassigned-import": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "react/exhaustive-deps": "error",
    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error"
  },
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "settings": {
    "react": {
      "version": "19.0"
    }
  },
  "overrides": [
    {
      "files": ["apps/**/*.{ts,tsx}", "packages/ui/**/*.{ts,tsx}"],
      "env": {
        "browser": true,
        "es2022": true
      }
    },
    {
      "files": [
        "apps/coach-app/src/CoachAppController.tsx",
        "apps/coach-app/src/critical-moment/main.tsx",
        "apps/coach-app/src/hostCallFallback.ts",
        "apps/coach-app/src/main.tsx",
        "apps/coach-app/src/move-sequence/MoveSequenceController.tsx",
        "apps/coach-app/src/move-sequence/main.tsx"
      ],
      "rules": {
        "no-unused-labels": "off"
      }
    },
    {
      "files": ["**/*.{test,spec}.{ts,tsx}", "tooling/scripts/**/*.test.ts"],
      "env": {
        "vitest": true
      },
      "rules": {
        "vitest/require-mock-type-parameters": "off"
      }
    },
    {
      "files": ["apps/central-host/src/review-session/ChessBoard.tsx"],
      "rules": {
        "jsx-a11y/interactive-supports-focus": "off",
        "jsx-a11y/label-has-associated-control": "off",
        "jsx-a11y/no-autofocus": "off",
        "jsx-a11y/role-supports-aria-props": "off"
      }
    },
    {
      "files": [
        "*.config.{js,mjs,ts}",
        "tooling/scripts/**/*.ts",
        "prototypes/**/*.mjs"
      ],
      "env": {
        "node": true
      }
    }
  ]
}
