---
import { publicBrandIcons } from "../../brandPublicAssets"

interface Props {
  canonical?: string
  description?: string
  indexable: boolean
  title: string
}

const { canonical, description, indexable, title } = Astro.props

/**
 * `chenStylexVitePlugin` serves authored StyleX through a virtual stylesheet
 * and injects the tags for it from `transformIndexHtml`. Astro renders pages
 * itself and never runs that hook, so the dev origin has to name them here or
 * every authored style disappears from `bun run dev` while the build looks
 * right.
 */
const developmentStylex = import.meta.env.DEV
---

<meta charset="UTF-8" />
{
  developmentStylex ? (
    <>
      <link rel="stylesheet" href="/virtual:stylex.css" />
      <script is:inline type="module" src="/@id/virtual:stylex:runtime" />
    </>
  ) : null
}
{description ? <meta name="description" content={description} /> : null}
<meta name="referrer" content="no-referrer" />
{indexable ? null : <meta name="robots" content="noindex,nofollow" />}
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<link rel="manifest" href="/site.webmanifest" />
<link
  rel="icon"
  type="image/svg+xml"
  media="(prefers-color-scheme: light)"
  href={publicBrandIcons.lightSvg}
/>
<link
  rel="icon"
  type="image/svg+xml"
  media="(prefers-color-scheme: dark)"
  href={publicBrandIcons.darkSvg}
/>
<link
  rel="apple-touch-icon"
  sizes="180x180"
  href={publicBrandIcons.light180}
/>
<meta
  name="theme-color"
  media="(prefers-color-scheme: light)"
  content="#F7F2E8"
/>
<meta
  name="theme-color"
  media="(prefers-color-scheme: dark)"
  content="#142B46"
/>
{canonical ? <link rel="canonical" href={canonical} /> : null}
{
  canonical && description ? (
    <>
      <meta property="og:title" content={title} />
      <meta property="og:description" content={description} />
      <meta property="og:url" content={canonical} />
      <meta property="og:type" content="website" />
      <meta property="og:site_name" content="ChenChess" />
      <meta name="twitter:card" content="summary" />
      <meta name="twitter:title" content={title} />
      <meta name="twitter:description" content={description} />
    </>
  ) : null
}
