{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": false,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "server-dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "../../packages/ui/src/vite-assets.d.ts",
    "dev.ts",
    "production.ts",
    "server.ts"
  ]
}
