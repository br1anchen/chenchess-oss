PORT=8787
# Use 0.0.0.0 only when the API must accept connections outside the host process/container.
HOST=127.0.0.1
RUST_LOG=chen_chess_coach_engine=debug,tower_http=info
# Required by the durable Game Import store and Firebase browser authentication.
FIREBASE_PROJECT_ID=
DEPLOYMENT_ENVIRONMENT=staging
FIRESTORE_DATABASE_ID=coach-app-staging
# The Coach Engine service account JSON. Its project must match
# FIREBASE_PROJECT_ID and its IAM access must be limited to
# FIRESTORE_DATABASE_ID.
COACH_FIREBASE_SERVICE_ACCOUNT_JSON=
# Staging-only secret used to HMAC beta-request email and source-IP rate-limit
# keys. Generate 32-256 random bytes; leave absent in production.
BETA_ACCESS_RATE_LIMIT_HMAC_KEY=
# Local isolated Firestore emulator alternative; no service-account JSON is used.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
# Local Firebase Auth emulator alternative. Unsigned emulator ID tokens are
# accepted only while this resolves to loopback; anything else is refused at
# startup, and no deployed environment sets it.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Optional: accept separately-minted Coach MCP access tokens alongside Firebase
# browser tokens. Leave all of these unset unless you run your own authorization
# server; naming only some of the first three is refused at startup.
# JWT_JWKS={"keys":[]}
# OAUTH_ISSUER=https://coach.example
# COACH_MCP_RESOURCE=https://coach.example/mcp
# COACH_MCP_SCOPE=coach:review
MAIA_BASE_URL=http://127.0.0.1:8080
STOCKFISH_PATH=stockfish
STOCKFISH_DEPTH=16

# Language Layer: env supplies only the OpenRouter secret. Model and endpoint
# live in the reviewed pin-record.json. Absent or empty key keeps the web
# surface on safe rendering.
OPENROUTER_API_KEY=
